---
// src/pages/ditr-2026.astro
// LP — DITR 2026 | Nemes & Teibel Advogados
// Revisão jurídica preventiva da DITR 2026
// Tráfego: Google Ads + orgânico
//
// A página é deliberadamente curta e gira em torno de dois eixos: o PRAZO
// e os DOCUMENTOS. Os pontos de atenção que antes viviam em uma seção
// própria foram fundidos em cada documento — é lá que eles fazem sentido.
import LPLayout from '../layouts/LPLayout.astro';
import '../styles/ditr-2026.css';

const whatsappUrl =
  "https://wa.me/556541410010?text=Ol%C3%A1%2C%20gostaria%20de%20conversar%20sobre%20a%20an%C3%A1lise%20jur%C3%ADdica%20da%20DITR%202026.";

// Cada item carrega o que o documento é (`what`) e a categoria que ele
// sustenta na análise (`tag`).
const documentItems = [
  {
    title: "Matrícula",
    what: "Situação registral e área total do imóvel.",
    tag: "Cruzamento cadastral",
  },
  {
    title: "CAR",
    what: "Recibo de inscrição, áreas ambientais e dados declarados.",
    tag: "Área tributável",
  },
  {
    title: "CCIR",
    what: "Informações cadastrais do imóvel perante o Incra.",
    tag: "Cadastro fundiário",
  },
  {
    title: "Cafir",
    what: "Dados do imóvel perante a Receita Federal.",
    tag: "Base da Receita",
  },
  {
    title: "DITR anterior",
    what: "Histórico das informações já apresentadas.",
    tag: "Histórico declaratório",
  },
  {
    title: "VTN",
    what: "Referências, laudo e fundamento do valor da terra nua.",
    tag: "Base de cálculo",
  },
  {
    title: "Exploração",
    what: "Produção, rebanho, pastagem e área efetivamente utilizada.",
    tag: "Alíquota aplicável",
  },
  {
    title: "Contratos",
    what: "Arrendamento, parceria, compra, venda ou sucessão.",
    tag: "Responsabilidade",
  },
];

const faqItems = [
  {
    q: "A análise jurídica substitui o contador?",
    a: "Não. A atuação jurídica verifica a coerência e a sustentação documental das informações do imóvel. Quando necessário, o trabalho é integrado ao contador, ao engenheiro agrônomo ou ao consultor ambiental responsável pelos dados técnicos.",
  },
  {
    q: "Quem declara quando a fazenda está arrendada?",
    a: "Perante a Receita Federal, a obrigação é do proprietário, titular do domínio útil ou possuidor. O contrato pode disciplinar responsabilidades entre as partes, mas não altera a sujeição perante o Fisco. Os dados produtivos devem ser solicitados ao arrendatário com antecedência.",
  },
  {
    q: "Vendi o imóvel depois de 1º de janeiro. Quem apresenta a DITR?",
    a: "Em regra, a declaração corresponde a quem era titular em 1º de janeiro de 2026. A aquisição também pode envolver responsabilidade por sucessão, por isso a documentação da operação e dos exercícios anteriores deve ser examinada.",
  },
  {
    q: "Quais imóveis merecem uma revisão preventiva?",
    a: "Especialmente imóveis médios e grandes, propriedades arrendadas, áreas com APP ou Reserva Legal relevantes, imóveis com divergências cadastrais, operações recentes de compra e venda, inventários, condomínios e holdings rurais.",
  },
  {
    q: "É possível corrigir uma DITR já transmitida?",
    a: "A retificação pode ser possível enquanto não iniciado procedimento de lançamento de ofício. Depois de uma intimação ou notificação, o caminho e os prazos mudam; a situação deve ser analisada imediatamente.",
  },
  {
    q: "Recebi uma notificação relacionada ao ITR. O que fazer?",
    a: "A notificação deve ser analisada antes de qualquer resposta ou pagamento. O prazo para impugnação é, em regra, de 30 dias contados da intimação, e a estratégia depende do conteúdo do lançamento e das provas disponíveis.",
  },
];
---

<LPLayout
  title="DITR 2026 | Nemes & Teibel Advogados"
  description="Prazo da DITR 2026 e os documentos necessários para declarar. Revisão jurídica preventiva de matrícula, CAR, CCIR, Cafir e VTN antes do envio à Receita Federal."
>

    <main>
      <div class="site-grid" aria-hidden="true"></div>

      <header class="site-header">
        <a class="brand" href="#inicio" aria-label="Nemes e Teibel Advogados">
          <img
            src="/img/logo-white.png"
            alt=""
            width="500"
            height="250"
            decoding="async"
          />
        </a>

        <nav class="desktop-nav" aria-label="Navegação principal">
          <a href="#prazo">Prazo</a>
          <span aria-hidden="true">·</span>
          <a href="#documentos">Documentos</a>
          <span aria-hidden="true">·</span>
          <a href="#como-funciona">Como funciona</a>
        </nav>

        <a class="header-cta" href={whatsappUrl} target="_blank" rel="noreferrer">
          Falar com a equipe
        </a>

        <details class="mobile-menu">
          <summary aria-label="Abrir menu">
            <span></span>
            <span></span>
          </summary>
          <nav aria-label="Navegação móvel">
            <a href="#prazo">Prazo</a>
            <a href="#documentos">Documentos</a>
            <a href="#como-funciona">Como funciona</a>
            <a href={whatsappUrl} target="_blank" rel="noreferrer">
              Falar com a equipe
            </a>
          </nav>
        </details>
      </header>

      <section class="hero" id="inicio">
        <picture class="hero-bg">
          <source
            media="(max-width: 767px)"
            srcset="/img/hero-ditr-2026-mobile.avif"
          />
          <img src="/img/hero-ditr-2026.avif" alt="" aria-hidden="true" />
        </picture>

        <div class="hero-inner">
          <div class="hero-copy">
            <p class="eyebrow">
              <span>DITR 2026</span>
              <i></i>
              10 AGO — 30 SET
            </p>
            <h1>
              Sua DITR está coerente com os documentos do imóvel rural?
            </h1>
            <p class="hero-description">
              Antes da entrega, é importante analisar matrícula, CAR, CCIR, Cafir,
              VTN, áreas ambientais e utilização do imóvel para identificar
              possíveis divergências perante a Receita Federal.
            </p>
            <a class="primary-cta" href={whatsappUrl} target="_blank" rel="noreferrer">
              <span>Solicitar análise preventiva</span>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
            </a>
            <p class="location">
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
              Atuação jurídica preventiva <b>·</b> Cuiabá/MT
            </p>
          </div>

          <div class="risk-note">
            <span class="shield">
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3 4.5 6v5.5c0 4.7 3.2 7.9 7.5 9.5 4.3-1.6 7.5-4.8 7.5-9.5V6L12 3Z"></path><path d="m8.5 12 2.1 2.1 4.9-5"></path></svg>
            </span>
            <p>
              O risco não está apenas no prazo.
              <strong>Está no que os documentos sustentam.</strong>
            </p>
          </div>
        </div>
      </section>

      <section class="prazo section-shell" id="prazo">
        <div class="prazo-heading">
          <p class="eyebrow">Prazo · DITR 2026</p>
          <h2>
            O prazo termina em <em>30 de setembro</em>. A regularização começa antes.
          </h2>
          <p class="prazo-lead">
            Inconsistências entre matrícula, CAR, CCIR, Cafir e VTN podem
            comprometer a declaração. Antecipe a análise para entregar a DITR
            com segurança e sem imprevistos.
          </p>
        </div>

        <div class="prazo-panel">
          <div class="prazo-countdown" data-deadline="2026-09-30" hidden>
            <span class="prazo-countdown-value"></span>
            <span class="prazo-countdown-label">dias até o encerramento</span>
          </div>

          <ol class="prazo-timeline">
            <li class="is-now">
              <span class="prazo-when">Agora</span>
              <strong>Revisão documental preventiva</strong>
              <p>
                Janela para reunir documentos, solicitar dados produtivos ao
                arrendatário e resolver divergências cadastrais.
              </p>
            </li>
            <li>
              <span class="prazo-when">
                <time datetime="2026-08-10">10 ago 2026</time>
              </span>
              <strong>Abertura da entrega</strong>
              <p>
                Início do período de apresentação da declaração à Receita
                Federal.
              </p>
            </li>
            <li>
              <span class="prazo-when">
                <time datetime="2026-09-30">30 set 2026</time>
              </span>
              <strong>Encerramento do prazo</strong>
              <p>
                Último dia para transmitir a DITR 2026 dentro do prazo
                regular.
              </p>
            </li>
          </ol>
        </div>
      </section>

      <section class="documents" id="documentos">
        <div class="documents-inner section-shell">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Documentos necessários</p>
              <h2>Saiba quais documentos são necessários para a análise do imóvel rural.</h2>
            </div>
            <p>
              Matrícula, CAR, CCIR, Cafir e documentos relacionados ao VTN são
              essenciais para verificar a situação cadastral, registral e fiscal
              do imóvel antes da entrega da DITR.
            </p>
          </div>

          <div class="doc-grid">
            {documentItems.map((item, index) => (
              /* `--i` escalona o `top` de cada card no empilhamento mobile. */
              <article class="doc-card" style={`--i: ${index}`}>
                <div class="doc-card-head">
                  <span class="doc-card-index">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <h3>{item.title}</h3>
                </div>
                <p class="doc-card-what">{item.what}</p>
                <span class="doc-card-tag">{item.tag}</span>
              </article>
            ))}
          </div>

          <p class="doc-closing">
            Matrícula, CAR, CCIR e cadastros fiscais devem apresentar
            informações coerentes. A análise preventiva verifica esses dados
            antes da transmissão da DITR.
          </p>

          <a class="primary-cta documents-cta" href={whatsappUrl} target="_blank" rel="noreferrer">
            <span>Enviar meus documentos para análise</span>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </section>

      <section class="process section-shell" id="como-funciona">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Como funciona</p>
            <h2>Uma análise organizada antes da transmissão.</h2>
          </div>
          <p>
            A atuação é dimensionada conforme o caso. Quando os dados dependem
            de conhecimento técnico, a equipe orienta a integração com o
            profissional habilitado.
          </p>
        </div>
        <ol class="process-grid">
          <li>
            <span>01</span>
            <h3>Contexto do imóvel</h3>
            <p>Entendimento da titularidade, exploração, histórico e prazo aplicável.</p>
          </li>
          <li>
            <span>02</span>
            <h3>Documentos</h3>
            <p>Recebimento dos cadastros, declarações, contratos e elementos técnicos.</p>
          </li>
          <li>
            <span>03</span>
            <h3>Análise integrada</h3>
            <p>Comparação dos dados e identificação das divergências ou pontos sensíveis.</p>
          </li>
          <li>
            <span>04</span>
            <h3>Orientação</h3>
            <p>Indicação das providências adequadas antes da apresentação da DITR.</p>
          </li>
        </ol>
        <div class="integration-note">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3 4.5 6v5.5c0 4.7 3.2 7.9 7.5 9.5 4.3-1.6 7.5-4.8 7.5-9.5V6L12 3Z"></path><path d="m8.5 12 2.1 2.1 4.9-5"></path></svg>
          <p>
            <strong>Atuação jurídica integrada.</strong>
            A análise não substitui contador, agrônomo ou consultor ambiental.
            Ela organiza juridicamente as informações e indica quando o suporte
            técnico é necessário.
          </p>
        </div>
      </section>

      <section class="authority section-shell">
        <div class="authority-heading">
          <p class="eyebrow">Experiência aplicada ao patrimônio rural</p>
          <h2>Direito Agrário, Fundiário e Ambiental lidos em conjunto.</h2>
        </div>
        <div class="lawyers">
          <article class="lawyer">
            <figure class="lawyer-portrait">
              <img
                src="/img/Manu.avif"
                alt="Manuela Nemes, sócia do escritório"
                width="1080"
                height="1350"
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                <span class="lawyer-years">15+</span>
                <span class="lawyer-years-label">anos de atuação</span>
              </figcaption>
            </figure>
            <div class="lawyer-body">
              <p class="lawyer-role">Sócia · OAB/MT</p>
              <h3>Manuela Nemes</h3>
              <ul class="lawyer-credentials">
                <li>Direito Agrário, Fundiário e Agronegócio</li>
                <li>Vice-Presidente da Comissão de Assuntos Fundiários da OAB/MT</li>
              </ul>
            </div>
          </article>

          <article class="lawyer">
            <figure class="lawyer-portrait">
              <img
                src="/img/paula.avif"
                alt="Paula Teibel, sócia do escritório"
                width="1080"
                height="1350"
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                <span class="lawyer-years">20+</span>
                <span class="lawyer-years-label">anos de atuação</span>
              </figcaption>
            </figure>
            <div class="lawyer-body">
              <p class="lawyer-role">Sócia · OAB/MT</p>
              <h3>Paula Teibel</h3>
              <ul class="lawyer-credentials">
                <li>Direito Agrário, Fundiário e Ambiental</li>
                <li>Ex-servidora do INTERMAT e integrante da Comissão de Assuntos Fundiários da CGJ/TJMT</li>
              </ul>
            </div>
          </article>
        </div>
      </section>

      <section class="faq section-shell">
        <div class="faq-heading">
          <p class="eyebrow">Perguntas frequentes</p>
          <h2>Dúvidas comuns antes de apresentar a DITR.</h2>
        </div>
        <div class="faq-list">
          {faqItems.map((item, index) => (
            <details>
              <summary>
                <span>{String(index + 1).padStart(2, "0")}</span>
                {item.q}
                <i aria-hidden="true"></i>
              </summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="final-cta section-shell">
        <div class="final-cta-line" aria-hidden="true"><i></i><span>DITR · 2026</span><i></i></div>
        <p class="eyebrow">Antes de transmitir</p>
        <h2>Verifique se os documentos sustentam o que será declarado.</h2>
        <p>
          Converse com a equipe da Nemes &amp; Teibel sobre a realidade documental
          da sua propriedade rural.
        </p>
        <a class="primary-cta" href={whatsappUrl} target="_blank" rel="noreferrer">
          <span>Solicitar avaliação do caso</span>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
        </a>
      </section>

      <footer class="minimal-footer">
        <div>
          <img
            class="footer-logo"
            src="/img/logo-white.png"
            alt="Nemes &amp; Teibel Advogados"
            width="500"
            height="250"
            loading="lazy"
            decoding="async"
          />
          <small>Direito Agrário · Fundiário · Ambiental</small>
        </div>
        <address>
          Av. Historiador Rubens de Mendonça, 2368<br />
          Bosque da Saúde · Cuiabá/MT
        </address>
        <div class="footer-contact">
          <a href="tel:+556541410010">(65) 4141-0010</a>
          <a href="mailto:nemeseteibeladvogados@hotmail.com">
            nemeseteibeladvogados@hotmail.com
          </a>
        </div>
        <p>
          Material de caráter informativo, com base na legislação vigente em
          julho de 2026. Não constitui parecer jurídico e não dispensa a análise
          do caso concreto.
        </p>
      </footer>

      <a
        class="floating-whatsapp"
        href={whatsappUrl}
        target="_blank"
        rel="noreferrer"
        aria-label="Conversar com a equipe pelo WhatsApp"
      >
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          <path d="M12 0C5.373 0 0 5.373 0 12c0 2.139.563 4.14 1.541 5.876L.057 23.887l6.156-1.616A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.8 9.8 0 01-4.992-1.363l-.358-.213-3.716.975.993-3.63-.234-.373A9.77 9.77 0 012.182 12c0-5.42 4.398-9.818 9.818-9.818 5.42 0 9.818 4.398 9.818 9.818 0 5.42-4.398 9.818-9.818 9.818z"/>
        </svg>
      </a>
    </main>

</LPLayout>

<style is:global>
  /* Hide the LPLayout green WhatsApp float — DITR has its own gold-themed one */
  body.ditr-page .wa-float {
    display: none !important;
  }
</style>

<script>
  // Add marker class for CSS scoping
  document.body.classList.add('ditr-page');

  // Contador de dias até o encerramento. Fica escondido por padrão e só
  // aparece quando há prazo pela frente — a página é prerenderizada, então
  // a conta precisa acontecer aqui, no cliente.
  const countdown = document.querySelector<HTMLElement>('.prazo-countdown');
  const deadlineAttr = countdown?.dataset.deadline;

  if (countdown && deadlineAttr) {
    const [year, month, day] = deadlineAttr.split('-').map(Number);
    const deadline = new Date(year, month - 1, day);
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const daysLeft = Math.ceil(
      (deadline.getTime() - today.getTime()) / 86_400_000
    );

    if (daysLeft > 0) {
      const value = countdown.querySelector('.prazo-countdown-value');
      const label = countdown.querySelector('.prazo-countdown-label');
      if (value) value.textContent = String(daysLeft);
      if (label) label.textContent = daysLeft === 1 ? 'dia até o encerramento' : 'dias até o encerramento';
      countdown.hidden = false;
    }
  }
</script>
